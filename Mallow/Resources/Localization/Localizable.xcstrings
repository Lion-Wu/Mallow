          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las URL de endpoint indicadas pueden continuar una conversación desde un ID de respuesta de OpenAI Responses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les URL de point de terminaison ci-dessous peuvent poursuivre une conversation à partir d’un ID de réponse OpenAI Responses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のエンドポイント URL のみ、OpenAI Responses の応答 ID から会話を継続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 엔드포인트 URL만 OpenAI Responses 응답 ID에서 대화를 계속할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有下列端点 URL 可以通过 OpenAI Responses 响应 ID 继续对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有下列端點 URL 可以透過 OpenAI Responses 回應 ID 繼續對話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the endpoint URLs listed below may continue from an OpenAI Responses response ID."
          }
        }
      }
    },
