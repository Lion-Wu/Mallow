    "VOICE_LOADING_AUDIO_DELAYED" : {
      "comment" : "Non-fatal wait for a complete generated audio segment",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الاتصال، لكن الصوت ليس جاهزًا بعد. يمكنك مواصلة الانتظار أو إعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung steht, aber das Audio ist noch nicht fertig. Sie können warten oder es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connected, but audio is not ready yet. You can keep waiting or retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión está establecida, pero el audio aún no está listo. Puedes seguir esperando o reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion est établie, mais l’audio n’est pas encore prêt. Vous pouvez patienter ou réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済みですが、音声の生成はまだ完了していません。待機を続けるか、再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되었지만 음성이 아직 준비되지 않았습니다. 계속 기다리거나 다시 시도할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已建立，音频尚未生成完成。可继续等待或重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線已建立，音訊尚未生成完成。可繼續等待或重試。"
          }
        }
      }
    },
    "VOICE_LOADING_RESPONSE_DELAYED" : {
      "comment" : "Shown when a connected chat stream has stopped producing tokens for a while",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء الاتصال، لكن لم تصل استجابة جديدة. يمكنك مواصلة الانتظار أو إعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung steht, aber es ist keine neue Antwort eingegangen. Sie können weiter warten oder es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connected, but no new response has arrived. You can keep waiting or retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión está establecida, pero no ha llegado ninguna respuesta nueva. Puedes seguir esperando o reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion est établie, mais aucune nouvelle réponse n’est arrivée. Vous pouvez patienter ou réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続は確立されていますが、新しい応答が届いていません。待機を続けるか、再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되었지만 새 응답이 도착하지 않았습니다. 계속 기다리거나 다시 시도할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已建立，但暂时没有新的响应。您可以继续等待或重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
