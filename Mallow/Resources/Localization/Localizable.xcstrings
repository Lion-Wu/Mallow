    "RECOVERY_RESET_WARNING": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم الاحتفاظ بالبيانات القابلة للاستعادة فقط، وحذف جميع البيانات المحلية الأخرى. لا يمكن التراجع عن هذا الإجراء. صدّر بياناتك أولاً إذا أردت الاحتفاظ بنسخة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wiederherstellbare Daten bleiben erhalten. Alle anderen lokalen Daten werden gelöscht. Dies kann nicht rückgängig gemacht werden. Exportiere zuerst deine Daten, wenn du eine Kopie behalten möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se conservarán los datos recuperables. Los demás datos locales se eliminarán. Esta acción no se puede deshacer. Si quieres conservar una copia, exporta primero tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les données récupérables seront conservées. Les autres données locales seront supprimées. Cette action est irréversible. Pour conserver une copie, exportez d’abord vos données."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元可能なデータのみが保持され、それ以外のローカルデータは削除されます。この操作は取り消せません。コピーを残す場合は、先にデータを書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 가능한 데이터만 유지되고 나머지 로컬 데이터는 삭제됩니다. 이 작업은 되돌릴 수 없습니다. 사본을 보관하려면 먼저 데이터를 내보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留可恢复的数据，其余本地数据将被删除。此操作不可撤销。如需保留副本，请先导出数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保留可復原的資料，其餘本機資料將被刪除。此操作無法復原。如需保留副本，請先匯出資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only recoverable data will be kept. All other local data will be deleted. This cannot be undone. Export your data first if you want to keep a copy."
          }
        }
      }
    },
    "RECOVERY_RESTORE_MESSAGES_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم استعادة الرسائل المحددة وسجلها المرتبط كمحادثات مستقلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Nachrichten und der zugehörige Verlauf werden als separate Chats wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes seleccionados y su historial relacionado se restaurarán como chats independientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sélectionnés et leur historique associé seront restaurés dans des conversations distinctes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したメッセージと関連する履歴を独立したチャットとして復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 메시지와 관련 대화 기록을 별도의 채팅으로 복원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把所选消息及其关联历史恢复为独立聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將把所選訊息及其相關歷史恢復為獨立聊天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected messages and their related history will be restored as separate chats."
          }
        }
      }
    },
