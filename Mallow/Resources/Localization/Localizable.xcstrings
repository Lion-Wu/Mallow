        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden deine aktuellen lokalen Chats, Nachrichten, Einstellungen und Voreinstellungen gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
