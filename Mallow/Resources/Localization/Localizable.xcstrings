    "ABOUT_OPEN_SOURCE_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ برنامج مفتوح المصدر منشور بموجب ترخيص MIT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist Open-Source-Software und wird unter der MIT-Lizenz veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un software de código abierto publicado bajo la licencia MIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un logiciel libre publié sous licence MIT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は MIT ライセンスで公開されているオープンソースソフトウェアです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은 MIT 라이선스로 배포되는 오픈 소스 소프트웨어입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是一款以 MIT 协议发布的开源软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是一款以 MIT 授權條款發佈的開源軟體。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is open source software, released under the MIT License."
          }
        }
      }
    },
