          }
        }
      }
    },
    "VOICE_LOADING_RESPONSE_NOT_STARTED" : {
      "comment" : "Shown when a connected chat request has not produced its first token for a while",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء الاتصال، لكن الخادم لم يبدأ الاستجابة بعد. يمكنك مواصلة الانتظار أو إعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
