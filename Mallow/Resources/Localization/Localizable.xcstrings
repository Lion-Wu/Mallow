    "TOOLS_ENABLE_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تدعم جميع النماذج استخدام الأدوات. قد يؤدي تمكينه إلى زيادة استخدام الرموز المميزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Modelle unterstützen die Tool-Nutzung. Durch die Aktivierung kann sich der Tokenverbrauch erhöhen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No todos los modelos admiten el uso de herramientas. Activarlo puede aumentar el uso de tokens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les modèles ne prennent pas en charge l’utilisation des outils. Son activation peut augmenter l’utilisation de jetons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのモデルがツール使用に対応しているわけではありません。有効にするとトークン使用量が増える可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 모델은 도구 사용을 지원하지 않습니다. 활성화하면 토큰 사용량이 늘어날 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并非所有模型都支持工具调用。启用后可能会增加 Token 用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並非所有模型都支援工具呼叫。啟用後可能會增加 Token 用量。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all models support tool use. Enabling it may increase token usage."
          }
        }
      }
    },
