    "CHAT_LOADING_RESPONSE_DELAYED" : {
      "comment" : "Shown in realtime voice mode when text generation stalls between tokens",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء الاتصال، لكن خدمة النص لم تُرجع محتوى جديدًا منذ مدة. يمكنك الاستمرار في الانتظار أو إعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung steht, aber der Textdienst hat längere Zeit keine neuen Inhalte geliefert. Sie können weiter warten oder es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connected, but the text service has not returned anything new. You can keep waiting or retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión está establecida, pero el servicio de texto lleva un tiempo sin devolver contenido nuevo. Puedes seguir esperando o reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion est établie, mais le service de texte n’a rien renvoyé de nouveau depuis un moment. Vous pouvez patienter ou réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続は確立されていますが、テキストサービスから新しい内容が長時間返されていません。待機を続けるか、再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결은 설정되었지만 텍스트 서비스가 오랫동안 새 내용을 반환하지 않았습니다. 계속 기다리거나 다시 시도할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已建立，但文本服务长时间没有返回新内容。您可以继续等待或重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線已建立，但文字服務長時間沒有傳回新內容。您可以繼續等待或重試。"
          }
        }
      }
    },
    "CHAT_LOADING_RESPONSE_NOT_STARTED" : {
      "comment" : "Shown in realtime voice mode when text generation has no first token",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء الاتصال، لكن خدمة النص لم تبدأ بالاستجابة بعد. يمكنك الاستمرار في الانتظار أو إعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung steht, aber der Textdienst hat noch nicht geantwortet. Sie können weiter warten oder es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connected, but the text service has not started responding. You can keep waiting or retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión está establecida, pero el servicio de texto aún no ha empezado a responder. Puedes seguir esperando o reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion est établie, mais le service de texte n’a pas encore commencé à répondre. Vous pouvez patienter ou réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続は確立されていますが、テキストサービスはまだ応答を開始していません。待機を続けるか、再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결은 설정되었지만 텍스트 서비스가 아직 응답을 시작하지 않았습니다. 계속 기다리거나 다시 시도할 수 있습니다."
          }
