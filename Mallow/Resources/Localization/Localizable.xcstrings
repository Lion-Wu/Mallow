    "MODEL_LIST_NOT_LOADED" : {
      "comment" : "Shown when no model catalog is available after the server connection timeout",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تحميل النماذج بعد. لا يمكنك إرسال الرسائل حتى تتوفر النماذج. تحقق من الاتصال بالخادم وحدّث قائمة النماذج في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Modelle wurden noch nicht geladen. Bis Modelle verfügbar sind, können Sie keine Nachrichten senden. Prüfen Sie die Serververbindung und aktualisieren Sie die Modellliste in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Models have not been loaded. You cannot send messages until models are available. Check the server connection and refresh the model list in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos aún no se han cargado. No puedes enviar mensajes hasta que estén disponibles. Comprueba la conexión con el servidor y actualiza la lista de modelos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles ne sont pas encore chargés. Vous ne pouvez pas envoyer de messages tant qu’ils ne sont pas disponibles. Vérifiez la connexion au serveur et actualisez la liste des modèles dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルを取得できていないため、メッセージを送信できません。サーバー接続を確認し、設定でモデル一覧を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델을 불러오지 못해 메시지를 보낼 수 없습니다. 서버 연결을 확인하고 설정에서 모델 목록을 새로 고치세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未获取到模型，暂时无法发送消息。请检查服务器连接，并在设置中刷新模型列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未取得模型，暫時無法傳送訊息。請檢查伺服器連線，並在設定中重新整理模型清單。"
          }
        }
      }
    },
