        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트만 보내고 모든 이미지를 무시하고 계속하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否仅发送文本并忽略所有图像？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是否只傳送文字並忽略所有圖像？"
