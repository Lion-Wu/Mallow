    "TOOLS_HIGH_RISK_AUTOMATIC_WARNING" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيسمح هذا بتشغيل أدوات الموقع والحافظة وعناوين URL وبيئة تشغيل JavaScript تلقائيًا عندما يسمح وضع التفويض بذلك. قد يزيد هذا من مخاطر كشف المعلومات الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch können Standort-, Zwischenablage-, URL- und JavaScript-Laufzeit-Tools automatisch ausgeführt werden, wenn der Autorisierungsmodus dies zulässt. Dies kann das Risiko einer Offenlegung privater Daten erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will allow location, clipboard, URL, and JavaScript Runtime tools to run automatically when permitted by the authorization mode. This may increase the risk of privacy exposure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto permitirá que las herramientas de ubicación, portapapeles, URL y entorno de ejecución de JavaScript se ejecuten automáticamente cuando lo permita el modo de autorización. Esto puede aumentar el riesgo de exposición de datos privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela permettra aux outils de localisation, de presse-papiers, d’URL et d’environnement d’exécution JavaScript de s’exécuter automatiquement lorsque le mode d’autorisation le permet. Cela peut accroître le risque de fuite de données privées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証方式で許可されている場合、位置情報、クリップボード、URL 操作、JavaScript ランタイムツールの自動実行が許可されます。プライバシー漏えいのリスクが高まる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 방식에서 허용하는 경우 위치, 클립보드, URL 및 JavaScript 런타임 도구가 자동으로 실행됩니다. 개인 정보 유출 위험이 높아질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将允许位置、剪贴板、URL 操作和 JavaScript 运行时工具在授权方式允许时自动运行。这可能增加隐私泄露风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將允許位置、剪貼簿、URL 操作和 JavaScript 執行環境工具在授權方式允許時自動執行。這可能會增加隱私洩露風險。"
          }
        }
      }
    },
