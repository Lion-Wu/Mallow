        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los ajustes de modelo seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de modèle sélectionnés seront supprimés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデル設定を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델 설정을 삭제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所选模型设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除所選模型設定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected model settings will be deleted."
          }
        }
      }
    },
