    "DATA_API_KEY_ACCOUNT_AMBIGUOUS": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد مفاتيح متعددة لهذا الحساب، لذا لا يمكن تحديد المفتاح الصحيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Schlüssel gehören zu diesem Konto. Der richtige Schlüssel kann nicht bestimmt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay varias claves para esta cuenta y no se puede determinar cuál es la correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs clés sont associées à ce compte ; il est impossible de déterminer laquelle utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントに複数のキーがあるため、使用するキーを特定できません。"
