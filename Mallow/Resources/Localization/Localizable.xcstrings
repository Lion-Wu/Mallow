    "SETTINGS_RESET_DEFAULTS_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى إعادة تعيين كل الخيارات إلى الافتراضيات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Optionen auf die Standardwerte zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restablecerá todas las opciones a los valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela réinitialisera toutes les options aux valeurs par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのオプションを既定値に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 옵션을 기본값으로 재설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将所有选项重置为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將所有選項重設為預設值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reset all options to defaults."
          }
        }
      }
    },
    "SETTINGS_RESET_DEVELOPER_DEFAULTS_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إعادة تعيين جميع خيارات المطور إلى قيمها الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Entwickleroptionen auf ihre Standardwerte zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restablecerá todas las opciones de desarrollador a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action réinitialisera toutes les options développeur à leurs valeurs par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての開発者向けオプションをデフォルト値に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 개발자 옵션을 기본값으로 재설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将所有开发者选项重置为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將所有開發者選項重設為預設值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reset all developer options to their default values."
          }
        }
      }
    },
    "SETTINGS_RESTORE_DEFAULTS_CONFIRMATION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الافتراضيات؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardwerte wiederherstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar valores predeterminados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer les valeurs par défaut ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定値に戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로 복원할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要恢复默认值吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要還原預設值嗎？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore defaults?"
          }
        }
      }
    },
    "SETTINGS_RESTORE_DEVELOPER_DEFAULTS_CONFIRMATION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
