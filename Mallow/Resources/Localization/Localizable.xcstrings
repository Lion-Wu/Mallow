    "DATA_DELETE_ATTACHMENTS_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف جميع مرفقات الرسائل المحددة. سيبقى نص الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Anhänge der ausgewählten Nachrichten werden gelöscht. Der Nachrichtentext bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los adjuntos de los mensajes seleccionados. Se conservará el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pièces jointes des messages sélectionnés seront supprimées. Le texte sera conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したメッセージの添付ファイルをすべて削除します。本文は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 메시지의 모든 첨부 파일이 삭제됩니다. 메시지 본문은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所选消息中的所有附件，保留消息正文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除所選訊息中的所有附件，保留訊息內文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All attachments in the selected messages will be deleted. Message text will be kept."
          }
        }
      }
    },
    "DATA_DELETE_CHATS_DESCRIPTION": {
