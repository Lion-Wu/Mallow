    "CHAT_CONTINUE_TEXT_ONLY": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد المتابعة بالنص فقط وتجاهل جميع الصور؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Text senden und alle Bilder ignorieren?"
