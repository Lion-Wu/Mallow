    "VOICE_ACCESSIBILITY_CONTROL_HINT" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر نقرتين للتحكم في الصوت الفوري. استخدم إجراء \"اضغط للتحدث\" لوضع الضغط للتحدث."
