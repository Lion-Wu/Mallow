    "CHAT_ADDITIONAL_IMAGE_LIMIT": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تتضمن هذه الرسالة %lld مرفق صورة إضافيًا. تم تجاهل الصور الزائدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachricht kann noch %lld weitere Bildanhänge enthalten. Zusätzliche Bilder wurden ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje puede incluir %lld archivos adjuntos de imagen adicionales. Las imágenes sobrantes se ignoraron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message peut inclure %lld pièces jointes image supplémentaires. Les images en trop ont été ignorées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージにはあと %lld 個の画像添付を追加できます。超過した画像は無視されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지에는 이미지 첨부 파일을 %lld개 더 포함할 수 있습니다. 초과한 이미지는 무시되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前消息还可添加 %lld 个图片附件，超出的图片已被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前訊息還可加入 %lld 個圖片附件，超出的圖片已被忽略。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message can include %lld additional image attachments. Extra images were ignored."
          }
        }
      }
    },
