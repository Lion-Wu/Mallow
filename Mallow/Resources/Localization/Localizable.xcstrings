    "VOICE_IMAGE_CONVERSATION_UNSUPPORTED": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لوضع الصوت إرسال هذه المحادثة لأنها تحتوي على صور، بينما لا يقبل النموذج المحدد سوى النص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprachmodus kann diese Unterhaltung nicht senden, weil sie Bilder enthält, das ausgewählte Modell aber nur Text akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de voz no puede enviar esta conversación porque contiene imágenes, pero el modelo seleccionado solo acepta texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode vocal ne peut pas envoyer cette conversation, car elle contient des images, mais le modèle sélectionné accepte uniquement le texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話には画像が含まれていますが、選択したモデルはテキスト入力のみを受け付けるため、音声モードでは送信できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에는 이미지가 포함되어 있지만 선택한 모델은 텍스트 입력만 지원하므로 음성 모드에서 보낼 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音模式无法发送此对话，因为其中包含图像，而所选模型仅支持文本输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音模式無法傳送此對話，因為其中包含圖像，而所選模型僅支援文字輸入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice mode cannot send this conversation because it contains images, but the selected model only accepts text."
          }
        }
      }
    },
