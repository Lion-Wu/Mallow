    "SETTINGS_DELETE_STATEFUL_ENDPOINT_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتمكن نقطة النهاية هذه بعد الحذف من متابعة المحادثات باستخدام معرّف استجابة OpenAI Responses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Endpunkt kann Chats anschließend nicht mehr über eine OpenAI-Responses-Antwort-ID fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint ya no podrá continuar chats desde un identificador de respuesta de OpenAI Responses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de terminaison ne pourra plus poursuivre les discussions à partir d’un identifiant de réponse OpenAI Responses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると、このエンドポイントでは OpenAI Responses のレスポンス ID からチャットを継続できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 이 엔드포인트에서 OpenAI Responses 응답 ID를 사용해 채팅을 계속할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，此端点将不能再通过 OpenAI Responses 响应 ID 继续对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後，此端點將無法再透過 OpenAI Responses 回應 ID 繼續對話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This endpoint will no longer continue chats from an OpenAI Responses response ID."
          }
        }
      }
    },
