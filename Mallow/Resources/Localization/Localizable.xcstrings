    "MODEL_IMAGE_SUPPORT_UNKNOWN": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر التأكد مما إذا كان هذا النموذج يدعم إدخال الصور. فعّل الخيار إذا كان يدعمه."
          }
        },
        "de": {
