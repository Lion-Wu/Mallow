    "MODEL_INFO_NOT_READY": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات النموذج ليست جاهزة بعد. انتظر اكتمال التحميل، أو اجلب النماذج مجددًا من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellinformationen sind noch nicht verfügbar. Warte, bis der Ladevorgang abgeschlossen ist, oder lade die Modelle in den Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información del modelo aún no está disponible. Espera a que termine la carga o vuelve a obtener los modelos en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations du modèle ne sont pas encore disponibles. Attendez la fin du chargement ou récupérez à nouveau les modèles dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル情報の準備ができていません。読み込みが完了するまで待つか、設定でモデルを再取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 정보가 아직 준비되지 않았습니다. 로딩이 완료될 때까지 기다리거나 설정에서 모델을 다시 가져오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型信息尚未就绪。请等待加载完成，或在设置中重新获取模型。"
