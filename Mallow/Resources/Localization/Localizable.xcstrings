    "CHAT_SAVE_FAILED": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ أحدث تغييرات المحادثة. قد تفقد هذه التغييرات إذا أغلقت التطبيق.\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Chatänderungen konnten nicht gespeichert werden. Wenn du die App schließt, können sie verloren gehen.\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los últimos cambios del chat. Si cierras la app, podrías perderlos.\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dernières modifications de vos conversations n’ont pas pu être enregistrées. Elles risquent d’être perdues si vous fermez l’application.\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のチャットの変更を保存できませんでした。アプリを閉じると、これらの変更が失われる可能性があります。\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 채팅 변경 사항을 저장하지 못했습니다. 앱을 닫으면 변경 사항이 손실될 수 있습니다.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的聊天更改未能保存。关闭应用可能导致这些更改丢失。\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的聊天變更未能儲存。關閉應用程式可能導致這些變更遺失。\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest chat changes could not be saved. They may be lost if you close the app.\n%@"
          }
        }
      }
    },
