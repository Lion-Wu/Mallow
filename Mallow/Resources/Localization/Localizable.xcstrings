    "VOICE_ACCESSIBILITY_CONTROL_HINT": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرتين للتحكم في الصوت الفوري. استخدم إجراء \"اضغط للتحدث\" لوضع الضغط للتحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um die Echtzeitstimme zu steuern. Verwende die Aktion „Zum Sprechen halten“ für Push-to-Talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para controlar la voz en tiempo real. Usa la acción \"Mantener pulsado para hablar\" para hablar pulsando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour contrôler la voix en temps réel. Utilisez l’action « Maintenir pour parler » pour le mode push-to-talk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでリアルタイム音声を操作します。プッシュトゥトークには「押して話す」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 실시간 음성을 제어하세요. 눌러서 말하기에는 \"눌러서 말하기\" 동작을 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击以控制实时语音。按住说话请使用“按住说话”操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下以控制即時語音。按住說話請使用「按住說話」操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to control realtime voice. Use the Hold to talk action for push-to-talk."
          }
        }
      }
    },
    "VOICE_ACCESSIBILITY_RECONNECT_HINT": {
