        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 계정에 여러 키가 있어 올바른 키를 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一账户存在多条密钥，无法确定应使用哪一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一帳號有多筆金鑰，無法確定應使用哪一筆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple keys share this account, so the correct key cannot be determined."
          }
        }
      }
    },
