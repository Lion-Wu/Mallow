    "SETTINGS_SAMPLING_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إضافة حقول أخذ العينات المفعّلة فقط إلى الطلبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur aktivierte Sampling-Felder werden Anfragen hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los campos de muestreo habilitados se agregan a las solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les champs d’échantillonnage activés sont ajoutés aux requêtes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にしたサンプリングフィールドのみがリクエストに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 샘플링 필드만 요청에 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有启用的采样字段会加入请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有啟用的取樣欄位會加入請求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enabled sampling fields are added to requests."
          }
        }
      }
    },
