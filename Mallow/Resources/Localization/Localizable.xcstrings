    "SETTINGS_STATEFUL_ENDPOINTS_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فقط لعناوين URL لنقاط النهاية المدرجة أدناه متابعة المحادثة من معرّف استجابة OpenAI Responses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
