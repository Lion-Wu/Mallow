        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除当前本地的聊天、消息、设置和预设。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
