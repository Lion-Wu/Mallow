    "VOICE_INTERRUPT_TASKS_DESCRIPTION": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال هناك مهام أخرى قيد التشغيل. المتابعة ستؤدي إلى مقاطعتها وبدء وضع الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Aufgaben laufen noch. Wenn du fortfährst, werden sie unterbrochen und der Sprachmodus startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía hay otras tareas en ejecución. Si continúas, se interrumpirán y se iniciará el modo de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres tâches sont encore en cours. Continuer les interrompra et démarrera le mode vocal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のタスクが実行中です。続行すると中断して音声モードを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 작업이 아직 실행 중입니다. 계속하면 해당 작업이 중단되고 음성 모드가 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仍有其他任务正在运行。继续将中断它们并开启语音模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前仍有其他任務正在執行。繼續將中斷它們並啟動語音模式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are other tasks still running. Continuing will interrupt them and start voice mode."
          }
        }
      }
    },
