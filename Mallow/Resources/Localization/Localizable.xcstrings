    "STORAGE_DELETE_FILES_WARNING": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف الملفات المحددة ومحتويات المجلدات نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Dateien und Ordnerinhalte werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados y el contenido de las carpetas se eliminarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sélectionnés et le contenu des dossiers seront supprimés définitivement. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルとフォルダの内容を完全に削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일과 폴더의 내용을 영구적으로 삭제합니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所选文件及文件夹中的内容。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所選檔案及資料夾中的內容。此操作無法復原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected files and folder contents will be permanently deleted. This cannot be undone."
          }
        }
      }
    },
