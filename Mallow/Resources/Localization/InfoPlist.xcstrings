          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에게 위치 정보 사용을 요청할 때 현재 위치를 읽는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你要求助理使用位置信息时读取你的当前位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在你要求助理使用位置資訊時讀取你的目前位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل صوتك لدعم وضع الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme aufnehmen, um den Sprachmodus zu unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your voice to support voice mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar tu voz para admitir el modo de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer votre voix afin de prendre en charge le mode vocal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モードに対応するために声を録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모드를 지원하기 위해 목소리를 녹음합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于录制你的语音，以支持语音模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於錄製你的語音，以支援語音模式。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة لقطة قصيرة لحركة الجهاز عندما تطلب من المساعد استخدام سياق حركة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Momentaufnahme der Gerätebewegung lesen, wenn du den Assistenten bittest, Gerätebewegungsdaten zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a short motion snapshot when you ask the assistant to use device motion context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer una muestra breve del movimiento del dispositivo cuando le pidas al asistente que use ese contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un bref instantané des mouvements de l’appareil lorsque vous demandez à l’assistant d’utiliser ce contexte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントにデバイスのモーション情報の使用を依頼したときに、短時間のモーションデータを取得するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에게 기기 동작 정보 사용을 요청할 때 짧은 동작 데이터 스냅샷을 읽는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你要求助理使用设备运动信息时读取短时运动数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在你要求助理使用裝置動態資訊時讀取短暫的動態資料。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة التذكيرات وإنشاؤها عندما تطلب من المساعد إدارة التذكيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen lesen und erstellen, wenn du den Assistenten bittest, deine Erinnerungen zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and create reminders when you ask the assistant to work with reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer y crear recordatorios cuando le pidas al asistente que gestione tus recordatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire et créer des rappels lorsque vous demandez à l’assistant de gérer vos rappels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントにリマインダーの操作を依頼したときに、リマインダーを読み取り、作成するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에게 미리 알림 작업을 요청할 때 미리 알림을 읽고 생성하는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你要求助理处理提醒事项时读取和创建提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在你要求助理處理提醒事項時讀取和建立提醒事項。"
          }
        }
      }
    },
