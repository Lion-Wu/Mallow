    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة أحداث التقويم وإنشاؤها عندما تطلب من المساعد إدارة جدولك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderereignisse lesen und erstellen, wenn du den Assistenten bittest, deinen Kalender zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and create calendar events when you ask the assistant to work with your schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer y crear eventos del calendario cuando le pidas al asistente que gestione tu agenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire et créer des événements de calendrier lorsque vous demandez à l’assistant de gérer votre emploi du temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに予定の操作を依頼したときに、カレンダーの予定を読み取り、作成するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에게 일정 작업을 요청할 때 캘린더 이벤트를 읽고 생성하는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你要求助理处理日程时读取和创建日历日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在你要求助理處理行程時讀取和建立行事曆事件。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
