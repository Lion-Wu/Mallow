    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل صوتك إلى نص لدعم وضع الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sprache in Text umwandeln, um den Sprachmodus zu unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert your speech into text to support voice mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir tu voz en texto para admitir el modo de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir votre voix en texte afin de prendre en charge le mode vocal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モードに対応するために話した内容をテキストに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모드를 지원하기 위해 말한 내용을 텍스트로 변환합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将你的语音转换为文字，以支持语音模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將你的語音轉換為文字，以支援語音模式。"
          }
        }
      }
    }
