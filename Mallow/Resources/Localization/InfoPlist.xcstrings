        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقاط صور وإضافتها إلى رسائل الدردشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos aufnehmen und zu Chatnachrichten hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos and add them to chat messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar fotos y agregarlas a los mensajes de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre des photos et les ajouter aux messages de chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮影してチャットメッセージに追加するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 촬영해 채팅 메시지에 추가하는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄照片并添加到聊天消息中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於拍攝照片並加入聊天訊息中。"
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "migrated",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة موقعك الحالي عندما تطلب من المساعد استخدام سياق الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinen aktuellen Standort lesen, wenn du den Assistenten bittest, Standortinformationen zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your current location when you ask the assistant to use location context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer tu ubicación actual cuando le pidas al asistente que use el contexto de ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire votre position actuelle lorsque vous demandez à l’assistant d’utiliser le contexte de localisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに位置情報の使用を依頼したときに、現在地を読み取るために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에게 위치 정보 사용을 요청할 때 현재 위치를 읽는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你要求助理使用位置信息时读取你的当前位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在你要求助理使用位置資訊時讀取你的目前位置。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "migrated",
